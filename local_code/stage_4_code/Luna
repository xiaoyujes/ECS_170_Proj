
# ============================================================
# 1. SETTINGS
# ============================================================

MODEL_TYPES = ["rnn", "lstm", "gru"]

# Use 500 for quick testing. Use None for final report.
LIMIT_PER_CLASS = None

MAX_VOCAB_SIZE = 40000
MIN_FREQ = 2
MAX_LEN = 500

BATCH_SIZE = 64
EPOCHS = 12
PATIENCE = 4

EMBED_DIM = 200
HIDDEN_DIM = 256
NUM_LAYERS = 2
DROPOUT = 0.30
BIDIRECTIONAL = True

LEARNING_RATE = 1e-3
WEIGHT_DECAY = 1e-5

OUTPUT_DIR_NAME = "classification_outputs_attention_strong"

PAD_TOKEN = "<PAD>"
UNK_TOKEN = "<UNK>"
PAD_IDX = 0
UNK_IDX = 1


# ============================================================
# 2. SETUP
# ============================================================

BASE_DIR = Path(__file__).resolve().parent
OUTPUT_DIR = BASE_DIR / OUTPUT_DIR_NAME
OUTPUT_DIR.mkdir(exist_ok=True)


def set_seed(seed: int = 42) -> None:
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)


def get_device() -> torch.device:
    if torch.cuda.is_available():
        return torch.device("cuda")
    if hasattr(torch.backends, "mps") and torch.backends.mps.is_available():
        return torch.device("mps")
    return torch.device("cpu")


# ============================================================
# 3. DATA FINDER
# ============================================================

def count_txt_files(data_dir: Path) -> Dict[str, int]:
    return {
        "train_neg": len(list((data_dir / "train" / "neg").glob("*.txt"))),
        "train_pos": len(list((data_dir / "train" / "pos").glob("*.txt"))),
        "test_neg": len(list((data_dir / "test" / "neg").glob("*.txt"))),
        "test_pos": len(list((data_dir / "test" / "pos").glob("*.txt"))),
    }


def is_valid_data_dir(data_dir: Path) -> bool:
    counts = count_txt_files(data_dir)
    return all(v > 0 for v in counts.values())


def find_text_classification_dir() -> Path:
    candidates = [
        BASE_DIR / "stage_4_data" / "text_classification",
        BASE_DIR / "text_classification",
        BASE_DIR.parent / "stage_4_data" / "text_classification",
    ]
    candidates.extend(BASE_DIR.rglob("text_classification"))

    for c in candidates:
        if c.exists() and is_valid_data_dir(c):
            return c

    print("Valid text_classification folder was not found. Trying to extract zip...")

    zip_candidates = []
    zip_candidates.extend(BASE_DIR.glob("*.zip"))
    zip_candidates.extend(BASE_DIR.parent.glob("*.zip"))
    zip_candidates.extend(BASE_DIR.rglob("*.zip"))

    zip_candidates = sorted(
        set(zip_candidates),
        key=lambda p: ("stage" not in p.name.lower(), "data" not in p.name.lower(), p.name.lower())
    )

    for zip_path in zip_candidates:
        print(f"Extracting: {zip_path}")
        try:
            with zipfile.ZipFile(zip_path, "r") as zf:
                zf.extractall(BASE_DIR)
        except zipfile.BadZipFile:
            continue

        post_candidates = [
            BASE_DIR / "stage_4_data" / "text_classification",
            BASE_DIR / "text_classification",
        ]
        post_candidates.extend(BASE_DIR.rglob("text_classification"))

        for c in post_candidates:
            if c.exists() and is_valid_data_dir(c):
                return c

    possible = list(BASE_DIR.rglob("text_classification"))
    msg = ["Could not find valid text_classification folder."]
    for d in possible:
        msg.append(f"{d} -> {count_txt_files(d)}")
    raise FileNotFoundError("\n".join(msg))


# ============================================================
# 4. PREPROCESSING
# ============================================================

def clean_text(text: str) -> str:
    text = text.lower()
    text = re.sub(r"<br\s*/?>", " ", text)
    text = re.sub(r"[^a-z0-9.!?'\s]", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text


def tokenize(text: str) -> List[str]:
    return re.findall(r"[a-z0-9']+|[.!?]", clean_text(text))


def read_text_file(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        return path.read_text(encoding="latin-1")


def load_file_paths(data_dir: Path, split: str, limit_per_class=None) -> List[Tuple[Path, int]]:
    items = []

    for label_name, label_id in [("neg", 0), ("pos", 1)]:
        folder = data_dir / split / label_name
        files = sorted(folder.glob("*.txt"))

        if limit_per_class is not None:
            files = files[:limit_per_class]

        for file_path in files:
            items.append((file_path, label_id))

    random.shuffle(items)
    return items


def build_vocab(train_items: List[Tuple[Path, int]]) -> Dict[str, int]:
    counter = Counter()

    for i, (path, _) in enumerate(train_items, start=1):
        counter.update(tokenize(read_text_file(path)))
        if i % 5000 == 0:
            print(f"  Vocabulary processed {i} files...")

    vocab = {PAD_TOKEN: PAD_IDX, UNK_TOKEN: UNK_IDX}

    for word, count in counter.most_common():
        if count < MIN_FREQ:
            continue
        if len(vocab) >= MAX_VOCAB_SIZE:
            break
        vocab[word] = len(vocab)

    return vocab


def encode_text(text: str, vocab: Dict[str, int]) -> List[int]:
    tokens = tokenize(text)
    ids = [vocab.get(tok, UNK_IDX) for tok in tokens[:MAX_LEN]]

    if len(ids) < MAX_LEN:
        ids += [PAD_IDX] * (MAX_LEN - len(ids))

    return ids


class ReviewDataset(Dataset):
    def __init__(self, items: List[Tuple[Path, int]], vocab: Dict[str, int]):
        self.items = items
        self.vocab = vocab

    def __len__(self):
        return len(self.items)

    def __getitem__(self, idx):
        path, label = self.items[idx]
        input_ids = encode_text(read_text_file(path), self.vocab)
        return {
            "input_ids": torch.tensor(input_ids, dtype=torch.long),
            "label": torch.tensor(label, dtype=torch.long),
        }


# ============================================================
# 5. MODEL WITH ATTENTION
# ============================================================

class AttentionPooling(nn.Module):
    """
    Learns which words/time steps are more important for classification.
    This often improves sentiment classification compared with only using
    the final hidden state.
    """

    def __init__(self, input_dim: int):
        super().__init__()
        self.attention = nn.Sequential(
            nn.Linear(input_dim, input_dim // 2),
            nn.Tanh(),
            nn.Linear(input_dim // 2, 1),
        )

    def forward(self, outputs, mask):
        # outputs: (batch, seq_len, hidden_dim * directions)
        # mask: (batch, seq_len), True for real tokens
        scores = self.attention(outputs).squeeze(-1)  # (batch, seq_len)
        scores = scores.masked_fill(~mask, -1e9)
        weights = torch.softmax(scores, dim=1).unsqueeze(-1)
        context = torch.sum(outputs * weights, dim=1)
        return context


class AttentionRecurrentClassifier(nn.Module):
    def __init__(self, vocab_size: int, model_type: str):
        super().__init__()

        model_type = model_type.lower()
        if model_type not in {"rnn", "lstm", "gru"}:
            raise ValueError("model_type must be rnn, lstm, or gru")

        self.model_type = model_type
        output_dim = HIDDEN_DIM * (2 if BIDIRECTIONAL else 1)

        self.embedding = nn.Embedding(vocab_size, EMBED_DIM, padding_idx=PAD_IDX)
        self.embedding_dropout = nn.Dropout(0.15)

        recurrent_dropout = DROPOUT if NUM_LAYERS > 1 else 0.0

        if model_type == "rnn":
            self.recurrent = nn.RNN(
                input_size=EMBED_DIM,
                hidden_size=HIDDEN_DIM,
                num_layers=NUM_LAYERS,
                batch_first=True,
                dropout=recurrent_dropout,
                bidirectional=BIDIRECTIONAL,
                nonlinearity="tanh",
            )
        elif model_type == "lstm":
            self.recurrent = nn.LSTM(
                input_size=EMBED_DIM,
                hidden_size=HIDDEN_DIM,
                num_layers=NUM_LAYERS,
                batch_first=True,
                dropout=recurrent_dropout,
                bidirectional=BIDIRECTIONAL,
            )
        else:
            self.recurrent = nn.GRU(
                input_size=EMBED_DIM,
                hidden_size=HIDDEN_DIM,
                num_layers=NUM_LAYERS,
                batch_first=True,
                dropout=recurrent_dropout,
                bidirectional=BIDIRECTIONAL,
            )

        self.attention_pool = AttentionPooling(output_dim)
        classifier_input_dim = output_dim * 3

        self.classifier = nn.Sequential(
            nn.LayerNorm(classifier_input_dim),
            nn.Dropout(DROPOUT),
            nn.Linear(classifier_input_dim, 256),
            nn.ReLU(),
            nn.Dropout(DROPOUT),
            nn.Linear(256, 2),
        )

    def forward(self, input_ids):
        mask = input_ids != PAD_IDX

        embedded = self.embedding(input_ids)
        embedded = self.embedding_dropout(embedded)
        outputs, _ = self.recurrent(embedded)

        attention_context = self.attention_pool(outputs, mask)

        mask_float = mask.unsqueeze(-1).float()
        lengths = mask_float.sum(dim=1).clamp(min=1.0)
        mean_pool = (outputs * mask_float).sum(dim=1) / lengths

        outputs_for_max = outputs.masked_fill(~mask.unsqueeze(-1), -1e9)
        max_pool = outputs_for_max.max(dim=1).values

        features = torch.cat([attention_context, mean_pool, max_pool], dim=1)
        return self.classifier(features)


# ============================================================
# 6. TRAIN / EVAL
# ============================================================

@torch.no_grad()
def evaluate(model, loader, criterion, device):
    model.eval()
    total_loss = 0.0
    all_preds = []
    all_labels = []

    for batch in loader:
        input_ids = batch["input_ids"].to(device)
        labels = batch["label"].to(device)

        logits = model(input_ids)
        loss = criterion(logits, labels)
        preds = torch.argmax(logits, dim=1)

        total_loss += loss.item()
        all_preds.extend(preds.cpu().numpy().tolist())
        all_labels.extend(labels.cpu().numpy().tolist())

    avg_loss = total_loss / max(len(loader), 1)
    acc = accuracy_score(all_labels, all_preds)
    precision, recall, f1, _ = precision_recall_fscore_support(
        all_labels,
        all_preds,
        average="weighted",
        zero_division=0,
    )
    return avg_loss, acc, precision, recall, f1


def plot_loss_curve(train_losses, test_losses, model_type: str):
    plt.figure()
    plt.plot(range(1, len(train_losses) + 1), train_losses, marker="o", label="Train Loss")
    plt.plot(range(1, len(test_losses) + 1), test_losses, marker="o", label="Test Loss")
    plt.xlabel("Epoch")
    plt.ylabel("Loss")
    plt.title(f"{model_type.upper()} Attention Loss Curve")
    plt.legend()
    plt.tight_layout()

    save_path = OUTPUT_DIR / f"{model_type}_attention_loss_curve.png"
    plt.savefig(save_path, dpi=200)
    plt.close()
    print(f"Saved loss curve: {save_path}")


def train_model(model_type: str, train_loader, test_loader, vocab_size: int, device):
    print("\n" + "=" * 70)
    print(f"Training {model_type.upper()} with attention")
    print("=" * 70)

    model = AttentionRecurrentClassifier(vocab_size, model_type).to(device)
    criterion = nn.CrossEntropyLoss(label_smoothing=0.03)

    optimizer = torch.optim.AdamW(model.parameters(), lr=LEARNING_RATE, weight_decay=WEIGHT_DECAY)

    scheduler = torch.optim.lr_scheduler.OneCycleLR(
        optimizer,
        max_lr=LEARNING_RATE,
        epochs=EPOCHS,
        steps_per_epoch=len(train_loader),
        pct_start=0.2,
        anneal_strategy="cos",
    )

    train_losses = []
    test_losses = []
    best_f1 = -1.0
    best_metrics = None
    bad_epochs = 0
    best_path = OUTPUT_DIR / f"best_{model_type}_attention_classifier.pt"

    for epoch in range(1, EPOCHS + 1):
        model.train()
        total_train_loss = 0.0

        for batch in train_loader:
            input_ids = batch["input_ids"].to(device)
            labels = batch["label"].to(device)

            optimizer.zero_grad()
            logits = model(input_ids)
            loss = criterion(logits, labels)
            loss.backward()

            nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            optimizer.step()
            scheduler.step()

            total_train_loss += loss.item()

        train_loss = total_train_loss / max(len(train_loader), 1)
        test_loss, acc, precision, recall, f1 = evaluate(model, test_loader, criterion, device)

        train_losses.append(train_loss)
        test_losses.append(test_loss)

        print(
            f"Epoch {epoch:02d}/{EPOCHS} | "
            f"Train Loss: {train_loss:.4f} | "
            f"Test Loss: {test_loss:.4f} | "
            f"Acc: {acc:.4f} | "
            f"Precision: {precision:.4f} | "
            f"Recall: {recall:.4f} | "
            f"F1: {f1:.4f}"
        )

        if f1 > best_f1:
            best_f1 = f1
            best_metrics = {
                "model": model_type.upper(),
                "best_epoch": epoch,
                "test_loss": test_loss,
                "accuracy": acc,
                "precision": precision,
                "recall": recall,
                "f1": f1,
            }
            torch.save(model.state_dict(), best_path)
            bad_epochs = 0
            print(f"  New best model saved: {best_path}")
        else:
            bad_epochs += 1

        if bad_epochs >= PATIENCE:
            print(f"Early stopping for {model_type.upper()}")
            break

    plot_loss_curve(train_losses, test_losses, model_type)
    return best_metrics


# ============================================================
# 7. MAIN
# ============================================================

def main():
    set_seed(42)
    device = get_device()

    print(f"Using device: {device}")
    print(f"Script folder: {BASE_DIR}")
    print(f"Output folder: {OUTPUT_DIR}")

    data_dir = find_text_classification_dir()
    print("\nUsing data directory:")
    print(data_dir)

    counts = count_txt_files(data_dir)
    print("\nFile counts:")
    for k, v in counts.items():
        print(f"  {k}: {v}")

    train_items = load_file_paths(data_dir, "train", LIMIT_PER_CLASS)
    test_items = load_file_paths(data_dir, "test", LIMIT_PER_CLASS)

    print(f"\nTrain size: {len(train_items)}")
    print(f"Test size: {len(test_items)}")

    if len(train_items) == 0 or len(test_items) == 0:
        raise ValueError("Empty dataset. Check train/pos, train/neg, test/pos, test/neg folders.")

    print("\nBuilding vocabulary...")
    vocab = build_vocab(train_items)
    print(f"Vocabulary size: {len(vocab)}")

    train_dataset = ReviewDataset(train_items, vocab)
    test_dataset = ReviewDataset(test_items, vocab)

    train_loader = DataLoader(
        train_dataset,
        batch_size=BATCH_SIZE,
        shuffle=True,
        num_workers=0,
        pin_memory=(device.type == "cuda"),
    )

    test_loader = DataLoader(
        test_dataset,
        batch_size=BATCH_SIZE,
        shuffle=False,
        num_workers=0,
        pin_memory=(device.type == "cuda"),
    )

    results = []
    for model_type in MODEL_TYPES:
        result = train_model(model_type, train_loader, test_loader, len(vocab), device)
        results.append(result)

    csv_path = OUTPUT_DIR / "classification_results_attention_strong.csv"
    with csv_path.open("w", newline="", encoding="utf-8") as f:
        fieldnames = ["model", "best_epoch", "test_loss", "accuracy", "precision", "recall", "f1"]
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        for row in results:
            writer.writerow(row)

    print("\n" + "=" * 70)
    print("Final Results")
    print("=" * 70)

    for row in results:
        print(
            f"{row['model']:>4} | "
            f"Best Epoch: {row['best_epoch']} | "
            f"Acc: {row['accuracy']:.4f} | "
            f"Precision: {row['precision']:.4f} | "
            f"Recall: {row['recall']:.4f} | "
            f"F1: {row['f1']:.4f}"
        )

    print(f"\nSaved results CSV: {csv_path}")
    print(f"Saved outputs in: {OUTPUT_DIR}")


if __name__ == "__main__":
    main()
